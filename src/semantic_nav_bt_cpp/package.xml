<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_nav_bt_cpp</name>
  <version>0.1.0</version>
  <description>BT.CPP 4 port of the TOSM semantic mission behavior tree:
    Groot2-monitorable executor (Groot2Publisher) that resolves semantic
    commands through the Python mediator service and drives Nav2.</description>
  <maintainer email="kimsang.m@g.skku.edu">Sangmin Kim</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>semantic_nav_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
