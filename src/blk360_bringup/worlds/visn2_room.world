    <!-- static top-down camera over the room center for the mission-console
         live view; +y up / +x right in the image (matches the paper maps) -->
    <model name="overhead_cam">
      <static>true</static>
      <pose>-2 -1.5 13 0 1.5708 1.5708</pose>
      <link name="link">
        <sensor name="overhead_camera" type="camera">
          <topic>/overhead/image_raw</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>960</width><height>720</height></image>
            <clip><near>0.1</near><far>60</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
